<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvStageNumber"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@color/primary"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRivalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stage 1: Street Rookie"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStagePrize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Phần thưởng: $1,200"
            android:textColor="@color/green_zone"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStageOpponent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvStageTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/accent"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStageAction"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/primary"
        android:text="THÁCH ĐẤU"
        android:textColor="@color/text_white"
        android:textSize="13sp" />

</LinearLayout>
