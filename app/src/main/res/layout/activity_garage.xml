<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/garage"
    android:padding="12dp">

    <RelativeLayout
        android:id="@+id/garageHeader"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/bg_card_secondary"
            android:text="← MENU"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvGarageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="GARAGE NÂNG CẤP XE"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvPlayerCash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="$2,000"
            android:textColor="@color/green_zone"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/garageStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/leftGaragePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35">

            <LinearLayout
                android:id="@+id/leftStats"
                android:layout_width="145dp"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <LinearLayout
                android:id="@+id/rightStats"
                android:layout_width="145dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <LinearLayout
                android:id="@+id/carSelector"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:gravity="center"
                android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvCarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCarTier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrevCar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="126dp"
                android:backgroundTint="@color/bg_card_secondary"
                android:text="‹"
                android:textSize="22sp" />
            <Button
                android:id="@+id/btnNextCar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="126dp"
                android:backgroundTint="@color/bg_card_secondary"
                android:text="›"
                android:textSize="22sp" />

            <FrameLayout
                android:id="@+id/carPreviewContainer"
                android:layout_width="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_height="145dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="76dp" />
            <Button
                android:id="@+id/btnBuyOrSelect"
                android:layout_width="240dp"
                android:layout_height="38dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="28dp"
                android:backgroundTint="@color/primary"
                android:text="CHỌN XE"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/rightUpgradePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="8dp">
            <GridLayout
                android:id="@+id/upgradesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:columnCount="3"
                android:rowCount="2"
                android:padding="4dp" />

            <ImageButton
                android:id="@+id/btnPaint"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="end|bottom"
                android:background="@color/bg_card_secondary"
                android:contentDescription="Sơn xe"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/paint" />
            <HorizontalScrollView
                android:id="@+id/paintPalettePanel"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="54dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/colorPaletteContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvUpgradePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="10sp"
        android:visibility="gone" />
</FrameLayout>
